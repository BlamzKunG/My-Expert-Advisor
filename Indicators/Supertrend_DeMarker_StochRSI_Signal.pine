//@version=5
indicator("Supertrend + DeMarker + Stoch RSI (Multi-Filter Edition)", overlay=true)

// =============================================================================
// 1. BASE INPUT SETTINGS
// =============================================================================
// 1.1 Supertrend (Main Trend)
atrPeriod       = input.int(10, "Supertrend ATR Period", group="1. Supertrend (Main Trend)")
atrMultiplier   = input.float(3.0, "Supertrend Multiplier", step=0.1, group="1. Supertrend (Main Trend)")

// 1.2 DeMarker
demPeriod       = input.int(14, "DeMarker Period", group="2. DeMarker")
demOversold     = input.float(0.3, "DeMarker Oversold Level", step=0.05, group="2. DeMarker")
demOverbought   = input.float(0.7, "DeMarker Overbought Level", step=0.05, group="2. DeMarker")

// 1.3 Stochastic RSI
rsiLength       = input.int(14, "RSI Length", group="3. Stoch RSI")
stochLength     = input.int(14, "Stoch Length", group="3. Stoch RSI")
smoothK         = input.int(3, "Smooth K", group="3. Stoch RSI")
smoothD         = input.int(3, "Smooth D", group="3. Stoch RSI")
stochOversold   = input.float(25.0, "Stoch RSI Oversold Zone", group="3. Stoch RSI")
stochOverbought = input.float(75.0, "Stoch RSI Overbought Zone", group="3. Stoch RSI")

// 1.4 Signal Spacing Cooldown
minBarsBetweenSignals = input.int(10, "Min Distance Between Signals (Bars)", minval=1, group="4. Basic Filter")

// =============================================================================
// 2. SIDEWAY & CHOP FILTER TOGGLES & SETTINGS
// =============================================================================
// 2.1 Kaufman's Efficiency Ratio (KER)
useER       = input.bool(true, "1) Enable Kaufman's Efficiency Ratio (KER)", group="5. Sideway Filter Selection")
erPeriod    = input.int(14, "KER Period", group="5.1 Kaufman ER Settings")
minER       = input.float(0.30, "Min Efficiency Ratio (Higher = Stronger Trend)", step=0.05, group="5.1 Kaufman ER Settings")

// 2.2 Choppiness Index (CHOP)
useChop     = input.bool(true, "2) Enable Choppiness Index (CHOP)", group="5. Sideway Filter Selection")
chopLen     = input.int(14, "CHOP Length", group="5.2 Choppiness Index Settings")
maxChop     = input.float(55.0, "Max CHOP Level (Below = Trending)", group="5.2 Choppiness Index Settings")

// 2.3 Bollinger Bands Width (BBW Volatility Filter)
useBBW      = input.bool(false, "3) Enable Bollinger Bands Width Filter", group="5. Sideway Filter Selection")
bbLength    = input.int(20, "BB Length", group="5.3 BB Width Settings")
bbMult      = input.float(2.0, "BB Multiplier", group="5.3 BB Width Settings")
bbSmaLen    = input.int(50, "BBW Average Period", group="5.3 BB Width Settings")

// 2.4 EMA Ribbon Spread (%)
useEMASpread= input.bool(false, "4) Enable EMA Spread % Filter", group="5. Sideway Filter Selection")
emaFastLen  = input.int(20, "EMA Fast Length", group="5.4 EMA Spread Settings")
emaSlowLen  = input.int(50, "EMA Slow Length", group="5.4 EMA Spread Settings")
minSpreadPct= input.float(0.15, "Min EMA Spread % (e.g. 0.15%)", step=0.05, group="5.4 EMA Spread Settings")

// 2.5 Multi-Timeframe Supertrend (MTF)
useMTF_ST   = input.bool(false, "5) Enable Higher Timeframe (MTF) Supertrend", group="5. Sideway Filter Selection")
htfTimeframe= input.timeframe("60", "Higher Timeframe", group="5.5 MTF Supertrend Settings")
htfAtrPeriod= input.int(10, "HTF ATR Period", group="5.5 MTF Supertrend Settings")
htfAtrMult  = input.float(3.0, "HTF Multiplier", step=0.1, group="5.5 MTF Supertrend Settings")

// 2.6 Dashboard
showDashboard = input.bool(true, "Show Filter Status Dashboard", group="6. Dashboard")

// =============================================================================
// 3. INDICATOR CALCULATIONS
// =============================================================================
// 3.1 Base Supertrend
[stValue, stDirection] = ta.supertrend(atrMultiplier, atrPeriod)
isUptrend   = stDirection < 0
isDowntrend = stDirection > 0

// 3.2 DeMarker
deMax = high > high[1] ? high - high[1] : 0.0
deMin = low < low[1] ? low[1] - low : 0.0
avgDeMax = ta.sma(deMax, demPeriod)
avgDeMin = ta.sma(deMin, demPeriod)
demValue = (avgDeMax + avgDeMin) != 0 ? avgDeMax / (avgDeMax + avgDeMin) : 0.5

// 3.3 Stochastic RSI
rsiVal = ta.rsi(close, rsiLength)
stochRsi = ta.stoch(rsiVal, rsiVal, rsiVal, stochLength)
k = ta.sma(stochRsi, smoothK)
d = ta.sma(k, smoothD)

// =============================================================================
// 4. SIDEWAY FILTER CALCULATIONS
// =============================================================================
// 4.1 Kaufman's Efficiency Ratio
changeNet = math.abs(close - close[erPeriod])
sumDiffs  = math.sum(math.abs(close - close[1]), erPeriod)
effRatio  = sumDiffs != 0 ? (changeNet / sumDiffs) : 0.0
passER    = not useER or (effRatio >= minER)

// 4.2 Choppiness Index
hhChop    = ta.highest(high, chopLen)
llChop    = ta.lowest(low, chopLen)
rangeChop = hhChop - llChop
sumAtr1   = math.sum(ta.atr(1), chopLen)
chopVal   = (rangeChop > 0 and sumAtr1 > 0) ? 100 * (math.log10(sumAtr1 / rangeChop) / math.log10(chopLen)) : 50.0
passChop  = not useChop or (chopVal <= maxChop)

// 4.3 Bollinger Bands Width
[bbBasis, bbUpper, bbLower] = ta.bb(close, bbLength, bbMult)
bbWidth   = bbBasis != 0 ? ((bbUpper - bbLower) / bbBasis) * 100 : 0.0
bbWidthAvg= ta.sma(bbWidth, bbSmaLen)
passBBW   = not useBBW or (bbWidth >= bbWidthAvg)

// 4.4 EMA Spread
emaFast   = ta.ema(close, emaFastLen)
emaSlow   = ta.ema(close, emaSlowLen)
emaSpread = close != 0 ? (math.abs(emaFast - emaSlow) / close) * 100 : 0.0
passEMA   = not useEMASpread or (emaSpread >= minSpreadPct)

// 4.5 MTF Supertrend
[htfSTVal, htfSTDir] = request.security(syminfo.tickerid, htfTimeframe, ta.supertrend(htfAtrMult, htfAtrPeriod), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
htfIsUp   = htfSTDir < 0
htfIsDown = htfSTDir > 0
passMTF_Buy  = not useMTF_ST or htfIsUp
passMTF_Sell = not useMTF_ST or htfIsDown

// รวมเงื่อนไข Filters ทั้งหมด
allFiltersPass_Buy  = passER and passChop and passBBW and passEMA and passMTF_Buy
allFiltersPass_Sell = passER and passChop and passBBW and passEMA and passMTF_Sell

// =============================================================================
// 5. ENTRY SIGNAL LOGIC
// =============================================================================
// Raw Entry Triggers
stochBuyCross = ta.crossover(k, d) and (k <= stochOversold or k[1] <= stochOversold)
demBuyCond    = demValue <= demOversold or demValue[1] <= demOversold or ta.crossover(demValue, demOversold)
rawBuySignal  = isUptrend and stochBuyCross and demBuyCond

stochSellCross = ta.crossunder(k, d) and (k >= stochOverbought or k[1] >= stochOverbought)
demSellCond    = demValue >= demOverbought or demValue[1] >= demOverbought or ta.crossunder(demValue, demOverbought)
rawSellSignal  = isDowntrend and stochSellCross and demSellCond

// Cooldown + Sideway Filter Application
var int lastSignalBar = -100
barsSinceLast = bar_index - lastSignalBar

validBuy  = rawBuySignal and allFiltersPass_Buy and (barsSinceLast >= minBarsBetweenSignals)
validSell = rawSellSignal and allFiltersPass_Sell and (barsSinceLast >= minBarsBetweenSignals)

if validBuy or validSell
    lastSignalBar := bar_index

// =============================================================================
// 6. PLOTTING & ALERTS
// =============================================================================
// Supertrend Line
plot(isUptrend ? stValue : na, "Supertrend Uptrend", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
plot(isDowntrend ? stValue : na, "Supertrend Downtrend", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)

// Buy / Sell Signals
plotshape(validBuy, title="BUY Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="BUY", textcolor=color.white)
plotshape(validSell, title="SELL Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL", textcolor=color.white)

// Alert Conditions
alertcondition(validBuy, title="Buy Signal Alert", message="[BUY] Supertrend + DeM + StochRSI trigger on {{ticker}} at {{close}}")
alertcondition(validSell, title="Sell Signal Alert", message="[SELL] Supertrend + DeM + StochRSI trigger on {{ticker}} at {{close}}")

// =============================================================================
// 7. REAL-TIME FILTER DASHBOARD
// =============================================================================
var table infoTable = table.new(position.top_right, 3, 7, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

if barstate.islast and showDashboard
    table.cell(infoTable, 0, 0, "Filter Name", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, "Status", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 0, "Current Value", bgcolor=color.navy, text_color=color.white, text_size=size.small)

    // 1. Kaufman ER
    table.cell(infoTable, 0, 1, "Kaufman ER", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, useER ? (passER ? "PASS" : "BLOCKED") : "OFF", bgcolor=useER ? (passER ? color.green : color.red) : color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 1, str.tostring(effRatio, "#.##") + " / " + str.tostring(minER, "#.##"), text_color=color.white, text_size=size.small)

    // 2. Choppiness Index
    table.cell(infoTable, 0, 2, "Chop Index", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, useChop ? (passChop ? "PASS" : "BLOCKED") : "OFF", bgcolor=useChop ? (passChop ? color.green : color.red) : color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 2, str.tostring(chopVal, "#.#") + " / " + str.tostring(maxChop, "#.#"), text_color=color.white, text_size=size.small)

    // 3. BB Width
    table.cell(infoTable, 0, 3, "BB Width", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 3, useBBW ? (passBBW ? "PASS" : "BLOCKED") : "OFF", bgcolor=useBBW ? (passBBW ? color.green : color.red) : color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 3, str.tostring(bbWidth, "#.##") + " (Avg " + str.tostring(bbWidthAvg, "#.##") + ")", text_color=color.white, text_size=size.small)

    // 4. EMA Spread %
    table.cell(infoTable, 0, 4, "EMA Spread %", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 4, useEMASpread ? (passEMA ? "PASS" : "BLOCKED") : "OFF", bgcolor=useEMASpread ? (passEMA ? color.green : color.red) : color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 4, str.tostring(emaSpread, "#.##") + "% / " + str.tostring(minSpreadPct, "#.##") + "%", text_color=color.white, text_size=size.small)

    // 5. MTF Supertrend
    table.cell(infoTable, 0, 5, "HTF Supertrend", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 5, useMTF_ST ? (htfIsUp ? "BULL" : "BEAR") : "OFF", bgcolor=useMTF_ST ? (htfIsUp ? color.green : color.red) : color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 5, "TF: " + htfTimeframe, text_color=color.white, text_size=size.small)

    // 6. Signal Cooldown
    table.cell(infoTable, 0, 6, "Signal Cooldown", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 6, barsSinceLast >= minBarsBetweenSignals ? "READY" : "WAIT", bgcolor=barsSinceLast >= minBarsBetweenSignals ? color.teal : color.orange, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 6, str.tostring(barsSinceLast) + " / " + str.tostring(minBarsBetweenSignals) + " bars", text_color=color.white, text_size=size.small)
