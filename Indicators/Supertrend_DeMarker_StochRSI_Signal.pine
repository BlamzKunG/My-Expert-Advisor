//@version=5
indicator("Supertrend + DeMarker + Stoch RSI (Donchian & Volume Pro Edition)", overlay=true)

// =============================================================================
// 1. BASE SETTINGS
// =============================================================================
// 1.1 Supertrend (Main Trend)
atrPeriod       = input.int(10, "Supertrend ATR Period", group="1. Supertrend (Main Trend)")
atrMultiplier   = input.float(3.0, "Supertrend Multiplier", step=0.1, group="1. Supertrend (Main Trend)")

// 1.2 DeMarker
demPeriod       = input.int(14, "DeMarker Period", group="2. DeMarker")
demOversold     = input.float(0.3, "DeMarker Oversold Level", step=0.05, group="2. DeMarker")
demOverbought   = input.float(0.7, "DeMarker Overbought Level", step=0.05, group="2. DeMarker")

// 1.3 Stochastic RSI
rsiLength       = input.int(14, "RSI Length", group="3. Stoch RSI")
stochLength     = input.int(14, "Stoch Length", group="3. Stoch RSI")
smoothK         = input.int(3, "Smooth K", group="3. Stoch RSI")
smoothD         = input.int(3, "Smooth D", group="3. Stoch RSI")
stochOversold   = input.float(25.0, "Stoch RSI Oversold Zone", group="3. Stoch RSI")
stochOverbought = input.float(75.0, "Stoch RSI Overbought Zone", group="3. Stoch RSI")

// 1.4 Signal Spacing Cooldown
minBarsBetweenSignals = input.int(10, "Min Distance Between Signals (Bars)", minval=1, group="4. Basic Filter")

// =============================================================================
// 2. STRUCTURAL & VOLUME FILTERS (ANTI-SIDEWAY)
// =============================================================================
// 2.1 Donchian / Swing Breakout (Price Action Filter)
useDonchian     = input.bool(true, "Enable Donchian / Swing Breakout Confirmation", group="5. Donchian / Swing Breakout Filter")
donchianPeriod  = input.int(20, "Donchian Lookback Period (Bars)", minval=2, group="5. Donchian / Swing Breakout Filter")
breakoutByClose = input.bool(false, "Require Close Breakout (True=Close, False=High/Low)", group="5. Donchian / Swing Breakout Filter")

// 2.2 Volume Expansion / RVOL Filter
useVolume       = input.bool(true, "Enable Volume Expansion Filter", group="6. Volume RVOL Filter")
volumeMaLen     = input.int(20, "Volume MA Length", minval=1, group="6. Volume RVOL Filter")
volumeMult      = input.float(1.2, "Min Volume Multiplier (x MA)", step=0.1, group="6. Volume RVOL Filter")

// =============================================================================
// 3. OPTIONAL MATHEMATICAL SIDEWAY FILTERS
// =============================================================================
// 3.1 Kaufman's Efficiency Ratio (KER)
useER           = input.bool(false, "Enable Kaufman's Efficiency Ratio (KER)", group="7. Optional Math Filters")
erPeriod        = input.int(14, "KER Period", group="7. Optional Math Filters")
minER           = input.float(0.30, "Min Efficiency Ratio", step=0.05, group="7. Optional Math Filters")

// 3.2 Choppiness Index (CHOP)
useChop         = input.bool(false, "Enable Choppiness Index (CHOP)", group="7. Optional Math Filters")
chopLen         = input.int(14, "CHOP Length", group="7. Optional Math Filters")
maxChop         = input.float(55.0, "Max CHOP Level (Below = Trending)", group="7. Optional Math Filters")

// 3.3 Bollinger Bands Width (BBW Volatility Filter)
useBBW          = input.bool(false, "Enable Bollinger Bands Width Filter", group="7. Optional Math Filters")
bbLength        = input.int(20, "BB Length", group="7. Optional Math Filters")
bbMult          = input.float(2.0, "BB Multiplier", group="7. Optional Math Filters")
bbSmaLen        = input.int(50, "BBW Average Period", group="7. Optional Math Filters")

// 3.4 EMA Ribbon Spread (%)
useEMASpread    = input.bool(false, "Enable EMA Spread % Filter", group="7. Optional Math Filters")
emaFastLen      = input.int(20, "EMA Fast Length", group="7. Optional Math Filters")
emaSlowLen      = input.int(50, "EMA Slow Length", group="7. Optional Math Filters")
minSpreadPct    = input.float(0.15, "Min EMA Spread %", step=0.05, group="7. Optional Math Filters")

// 3.5 Multi-Timeframe Supertrend (MTF)
useMTF_ST       = input.bool(false, "Enable Higher Timeframe Supertrend", group="7. Optional Math Filters")
htfTimeframe    = input.timeframe("60", "Higher Timeframe", group="7. Optional Math Filters")
htfAtrPeriod    = input.int(10, "HTF ATR Period", group="7. Optional Math Filters")
htfAtrMult      = input.float(3.0, "HTF Multiplier", step=0.1, group="7. Optional Math Filters")

// 3.6 Dashboard
showDashboard   = input.bool(true, "Show Filter Status Dashboard", group="8. Dashboard")

// =============================================================================
// 4. INDICATOR CALCULATIONS
// =============================================================================
// 4.1 Base Supertrend
[stValue, stDirection] = ta.supertrend(atrMultiplier, atrPeriod)
isUptrend   = stDirection < 0
isDowntrend = stDirection > 0

// 4.2 DeMarker
deMax = high > high[1] ? high - high[1] : 0.0
deMin = low < low[1] ? low[1] - low : 0.0
avgDeMax = ta.sma(deMax, demPeriod)
avgDeMin = ta.sma(deMin, demPeriod)
demValue = (avgDeMax + avgDeMin) != 0 ? avgDeMax / (avgDeMax + avgDeMin) : 0.5

// 4.3 Stochastic RSI
rsiVal = ta.rsi(close, rsiLength)
stochRsi = ta.stoch(rsiVal, rsiVal, rsiVal, stochLength)
k = ta.sma(stochRsi, smoothK)
d = ta.sma(k, smoothD)

// =============================================================================
// 5. ANTI-SIDEWAY & STRUCTURAL FILTER CALCULATIONS
// =============================================================================
// 5.1 Donchian / Swing High-Low Breakout
donchianHigh = ta.highest(high[1], donchianPeriod)
donchianLow  = ta.lowest(low[1], donchianPeriod)

passDonchian_Buy  = not useDonchian or (breakoutByClose ? (close >= donchianHigh) : (high >= donchianHigh))
passDonchian_Sell = not useDonchian or (breakoutByClose ? (close <= donchianLow)  : (low <= donchianLow))

// 5.2 Volume Expansion / RVOL
hasVolume    = not na(volume) and volume > 0
volMa        = ta.sma(volume, volumeMaLen)
volThreshold = volMa * volumeMult
passVolume   = not useVolume or not hasVolume or (volume >= volThreshold)

// 5.3 Kaufman's Efficiency Ratio
changeNet = math.abs(close - close[erPeriod])
sumDiffs  = math.sum(math.abs(close - close[1]), erPeriod)
effRatio  = sumDiffs != 0 ? (changeNet / sumDiffs) : 0.0
passER    = not useER or (effRatio >= minER)

// 5.4 Choppiness Index
hhChop    = ta.highest(high, chopLen)
llChop    = ta.lowest(low, chopLen)
rangeChop = hhChop - llChop
sumAtr1   = math.sum(ta.atr(1), chopLen)
chopVal   = (rangeChop > 0 and sumAtr1 > 0) ? 100 * (math.log10(sumAtr1 / rangeChop) / math.log10(chopLen)) : 50.0
passChop  = not useChop or (chopVal <= maxChop)

// 5.5 Bollinger Bands Width
[bbBasis, bbUpper, bbLower] = ta.bb(close, bbLength, bbMult)
bbWidth   = bbBasis != 0 ? ((bbUpper - bbLower) / bbBasis) * 100 : 0.0
bbWidthAvg= ta.sma(bbWidth, bbSmaLen)
passBBW   = not useBBW or (bbWidth >= bbWidthAvg)

// 5.6 EMA Spread
emaFast   = ta.ema(close, emaFastLen)
emaSlow   = ta.ema(close, emaSlowLen)
emaSpread = close != 0 ? (math.abs(emaFast - emaSlow) / close) * 100 : 0.0
passEMA   = not useEMASpread or (emaSpread >= minSpreadPct)

// 5.7 MTF Supertrend
[htfSTVal, htfSTDir] = request.security(syminfo.tickerid, htfTimeframe, ta.supertrend(htfAtrMult, htfAtrPeriod), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
htfIsUp   = htfSTDir < 0
htfIsDown = htfSTDir > 0
passMTF_Buy  = not useMTF_ST or htfIsUp
passMTF_Sell = not useMTF_ST or htfIsDown

// Combine All Filter Validations
allFiltersPass_Buy  = passDonchian_Buy and passVolume and passER and passChop and passBBW and passEMA and passMTF_Buy
allFiltersPass_Sell = passDonchian_Sell and passVolume and passER and passChop and passBBW and passEMA and passMTF_Sell

// =============================================================================
// 6. ENTRY SIGNAL LOGIC
// =============================================================================
// Raw Triggers (Supertrend + Stoch RSI + DeMarker)
stochBuyCross = ta.crossover(k, d) and (k <= stochOversold or k[1] <= stochOversold)
demBuyCond    = demValue <= demOversold or demValue[1] <= demOversold or ta.crossover(demValue, demOversold)
rawBuySignal  = isUptrend and stochBuyCross and demBuyCond

stochSellCross = ta.crossunder(k, d) and (k >= stochOverbought or k[1] >= stochOverbought)
demSellCond    = demValue >= demOverbought or demValue[1] >= demOverbought or ta.crossunder(demValue, demOverbought)
rawSellSignal  = isDowntrend and stochSellCross and demSellCond

// Cooldown & Filtered Signal Execution
var int lastSignalBar = -100
barsSinceLast = bar_index - lastSignalBar

validBuy  = rawBuySignal and allFiltersPass_Buy and (barsSinceLast >= minBarsBetweenSignals)
validSell = rawSellSignal and allFiltersPass_Sell and (barsSinceLast >= minBarsBetweenSignals)

if validBuy or validSell
    lastSignalBar := bar_index

// =============================================================================
// 7. PLOTTING & ALERTS
// =============================================================================
// Supertrend Line
plot(isUptrend ? stValue : na, "Supertrend Uptrend", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
plot(isDowntrend ? stValue : na, "Supertrend Downtrend", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)

// Donchian Breakout Reference Levels (Optional visualization)
plot(useDonchian ? donchianHigh : na, "Donchian High (Resistance)", color=color.new(color.teal, 60), style=plot.style_stepline)
plot(useDonchian ? donchianLow : na, "Donchian Low (Support)", color=color.new(color.maroon, 60), style=plot.style_stepline)

// Buy / Sell Signals
plotshape(validBuy, title="BUY Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="BUY", textcolor=color.white)
plotshape(validSell, title="SELL Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL", textcolor=color.white)

// Alert Conditions
alertcondition(validBuy, title="Buy Signal Alert", message="[BUY] Supertrend + DeM + StochRSI trigger on {{ticker}} at {{close}}")
alertcondition(validSell, title="Sell Signal Alert", message="[SELL] Supertrend + DeM + StochRSI trigger on {{ticker}} at {{close}}")

// =============================================================================
// 8. REAL-TIME FILTER DASHBOARD
// =============================================================================
var table infoTable = table.new(position.top_right, 3, 9, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

if barstate.islast and showDashboard
    table.cell(infoTable, 0, 0, "Filter Name", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, "Status", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 0, "Current Value", bgcolor=color.navy, text_color=color.white, text_size=size.small)

    // 1. Donchian Breakout
    bool donchianPassCurr = (isUptrend and passDonchian_Buy) or (isDowntrend and passDonchian_Sell)
    table.cell(infoTable, 0, 1, "Donchian Break", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, useDonchian ? (donchianPassCurr ? "PASS" : "BLOCKED") : "OFF", bgcolor=useDonchian ? (donchianPassCurr ? color.green : color.red) : color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 1, isUptrend ? ("H: " + str.tostring(donchianHigh, "#.##")) : ("L: " + str.tostring(donchianLow, "#.##")), text_color=color.white, text_size=size.small)

    // 2. Volume RVOL
    table.cell(infoTable, 0, 2, "Volume (RVOL)", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, useVolume ? (passVolume ? "PASS" : "LOW VOL") : "OFF", bgcolor=useVolume ? (passVolume ? color.green : color.red) : color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 2, hasVolume ? (str.tostring(volume, "#") + " / " + str.tostring(volThreshold, "#")) : "No Vol Data", text_color=color.white, text_size=size.small)

    // 3. Kaufman ER
    table.cell(infoTable, 0, 3, "Kaufman ER", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 3, useER ? (passER ? "PASS" : "BLOCKED") : "OFF", bgcolor=useER ? (passER ? color.green : color.red) : color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 3, str.tostring(effRatio, "#.##") + " / " + str.tostring(minER, "#.##"), text_color=color.white, text_size=size.small)

    // 4. Choppiness Index
    table.cell(infoTable, 0, 4, "Chop Index", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 4, useChop ? (passChop ? "PASS" : "BLOCKED") : "OFF", bgcolor=useChop ? (passChop ? color.green : color.red) : color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 4, str.tostring(chopVal, "#.#") + " / " + str.tostring(maxChop, "#.#"), text_color=color.white, text_size=size.small)

    // 5. BB Width
    table.cell(infoTable, 0, 5, "BB Width", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 5, useBBW ? (passBBW ? "PASS" : "BLOCKED") : "OFF", bgcolor=useBBW ? (passBBW ? color.green : color.red) : color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 5, str.tostring(bbWidth, "#.##") + " (Avg " + str.tostring(bbWidthAvg, "#.##") + ")", text_color=color.white, text_size=size.small)

    // 6. EMA Spread %
    table.cell(infoTable, 0, 6, "EMA Spread %", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 6, useEMASpread ? (passEMA ? "PASS" : "BLOCKED") : "OFF", bgcolor=useEMASpread ? (passEMA ? color.green : color.red) : color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 6, str.tostring(emaSpread, "#.##") + "% / " + str.tostring(minSpreadPct, "#.##") + "%", text_color=color.white, text_size=size.small)

    // 7. MTF Supertrend
    table.cell(infoTable, 0, 7, "HTF Supertrend", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 7, useMTF_ST ? (htfIsUp ? "BULL" : "BEAR") : "OFF", bgcolor=useMTF_ST ? (htfIsUp ? color.green : color.red) : color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 7, "TF: " + htfTimeframe, text_color=color.white, text_size=size.small)

    // 8. Signal Cooldown
    table.cell(infoTable, 0, 8, "Signal Cooldown", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 8, barsSinceLast >= minBarsBetweenSignals ? "READY" : "WAIT", bgcolor=barsSinceLast >= minBarsBetweenSignals ? color.teal : color.orange, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 8, str.tostring(barsSinceLast) + " / " + str.tostring(minBarsBetweenSignals) + " bars", text_color=color.white, text_size=size.small)
