//@version=6
indicator("Zerith - Supertrend + DeMarker + Stoch RSI Multi-TF Signal Pro", overlay=true)

// =============================================================================
// 1. MASTER TREND FILTER SETTINGS
// =============================================================================
grp_trend = "1. Supertrend & Trend Filters"
useTrendFilter      = input.bool(true, "Enable Trend Filter (กรองเทรนด์)", group=grp_trend)
trendMode           = input.string("Chart Supertrend", "Trend Filter Mode (รูปแบบกรองเทรนด์)", options=["Chart Supertrend", "Higher Timeframe (HTF) Supertrend", "200 EMA Baseline", "Dual Supertrend (Chart + HTF)", "None (No Filter)"], group=grp_trend)

// 1.1 Base Supertrend
atrPeriod           = input.int(10, "Supertrend ATR Period", group=grp_trend)
atrMultiplier       = input.float(3.0, "Supertrend Multiplier", step=0.1, group=grp_trend)

// 1.2 Higher Timeframe Supertrend
htfTimeframe        = input.timeframe("60", "Higher Timeframe (HTF)", group=grp_trend)
htfAtrPeriod        = input.int(10, "HTF ATR Period", group=grp_trend)
htfAtrMult          = input.float(3.0, "HTF Multiplier", step=0.1, group=grp_trend)

// 1.3 200 EMA Baseline
useEma200           = input.bool(false, "Enable 200 EMA Trend Baseline", group=grp_trend)
ema200Len           = input.int(200, "EMA Length", group=grp_trend)

// =============================================================================
// 2. SIGNAL GENERATORS: DEMARKER & STOCHASTIC RSI
// =============================================================================
grp_signal = "2. Signal Engines (DeMarker & Stoch RSI)"
signalMode          = input.string("Combined (DeMarker + Stoch RSI)", "Entry Signal Mode", options=["Combined (DeMarker + Stoch RSI)", "DeMarker Only", "Stoch RSI Only", "Momentum Continuation"], group=grp_signal)

// 2.1 DeMarker Settings
useDeMarker         = input.bool(true, "Enable DeMarker Module", group=grp_signal)
demPeriod           = input.int(14, "DeMarker Period", group=grp_signal)
demOversold         = input.float(0.3, "DeMarker Oversold Level", step=0.05, group=grp_signal)
demOverbought       = input.float(0.7, "DeMarker Overbought Level", step=0.05, group=grp_signal)

// 2.2 Stochastic RSI Settings
useStochRsi         = input.bool(true, "Enable Stoch RSI Module", group=grp_signal)
rsiLength           = input.int(14, "RSI Length", group=grp_signal)
stochLength         = input.int(14, "Stoch Length", group=grp_signal)
smoothK             = input.int(3, "Smooth K", group=grp_signal)
smoothD             = input.int(3, "Smooth D", group=grp_signal)
stochOversold       = input.float(25.0, "Stoch RSI Oversold Zone", group=grp_signal)
stochOverbought     = input.float(75.0, "Stoch RSI Overbought Zone", group=grp_signal)

// 2.3 Signal Spacing Cooldown
minBarsBetweenSignals = input.int(10, "Min Distance Between Signals (Bars, 0=Off)", minval=0, group=grp_signal)

// =============================================================================
// 3. STRUCTURAL & ANTI-SIDEWAY FILTERS
// =============================================================================
grp_struct = "3. Structural & Volume Filters (Anti-Sideway)"
useDonchian         = input.bool(true, "Enable Donchian Swing Breakout Filter", group=grp_struct)
donchianPeriod      = input.int(20, "Donchian Lookback Period (Bars)", minval=2, group=grp_struct)
breakoutByClose     = input.bool(false, "Require Close Breakout (True=Close, False=High/Low)", group=grp_struct)

useVolume           = input.bool(true, "Enable Volume Expansion (RVOL) Filter", group=grp_struct)
volumeMaLen         = input.int(20, "Volume MA Length", minval=1, group=grp_struct)
volumeMult          = input.float(1.2, "Min Volume Multiplier (x MA)", step=0.1, group=grp_struct)

// =============================================================================
// 4. OPTIONAL ADVANCED MATHEMATICAL FILTERS
// =============================================================================
grp_opt = "4. Optional Advanced Math Filters"
useER               = input.bool(false, "Enable Kaufman's Efficiency Ratio (KER)", group=grp_opt)
erPeriod            = input.int(14, "KER Period", group=grp_opt)
minER               = input.float(0.30, "Min Efficiency Ratio", step=0.05, group=grp_opt)

useChop             = input.bool(false, "Enable Choppiness Index (CHOP)", group=grp_opt)
chopLen             = input.int(14, "CHOP Length", group=grp_opt)
maxChop             = input.float(55.0, "Max CHOP Level (Below = Trending)", group=grp_opt)

useBBW              = input.bool(false, "Enable Bollinger Bands Width Filter", group=grp_opt)
bbLength            = input.int(20, "BB Length", group=grp_opt)
bbMult              = input.float(2.0, "BB Multiplier", group=grp_opt)
bbSmaLen            = input.int(50, "BBW Average Period", group=grp_opt)

useEMASpread        = input.bool(false, "Enable EMA Spread % Filter", group=grp_opt)
emaFastLen          = input.int(20, "EMA Fast Length", group=grp_opt)
emaSlowLen          = input.int(50, "EMA Slow Length", group=grp_opt)
minSpreadPct        = input.float(0.15, "Min EMA Spread %", step=0.05, group=grp_opt)

// =============================================================================
// 5. VISUALS & DASHBOARD
// =============================================================================
grp_ui = "5. Display & Dashboard"
showDashboard       = input.bool(true, "Show Filter Status Dashboard", group=grp_ui)
dashboardPosition   = input.string("Top Right", "Dashboard Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=grp_ui)
plotSupertrendLine  = input.bool(true, "Plot Supertrend Line on Chart", group=grp_ui)
plotEmaBaseline     = input.bool(true, "Plot 200 EMA Baseline", group=grp_ui)
plotDonchianLevels  = input.bool(false, "Plot Donchian S/R Levels", group=grp_ui)

// =============================================================================
// 6. NATIVE REAL-TIME INDICATOR CALCULATIONS (ZERO-LAG)
// =============================================================================
// 6.1 Chart Supertrend
[stValue, stDirection] = ta.supertrend(atrMultiplier, atrPeriod)
isUptrend   = stDirection < 0
isDowntrend = stDirection > 0

// 6.2 Higher Timeframe (HTF) Supertrend
[htfSTVal, htfSTDir] = request.security(syminfo.tickerid, htfTimeframe, ta.supertrend(htfAtrMult, htfAtrPeriod), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
htfIsUp   = htfSTDir < 0
htfIsDown = htfSTDir > 0

// 6.3 200 EMA Baseline
ema200Val = ta.ema(close, ema200Len)
emaIsUp   = close >= ema200Val
emaIsDown = close <= ema200Val

// Master Trend Filter Decision Logic
bool allowBuyTrend  = true
bool allowSellTrend = true

if useTrendFilter
    if trendMode == "Chart Supertrend"
        allowBuyTrend  := isUptrend
        allowSellTrend := isDowntrend
    else if trendMode == "Higher Timeframe (HTF) Supertrend"
        allowBuyTrend  := htfIsUp
        allowSellTrend := htfIsDown
    else if trendMode == "200 EMA Baseline"
        allowBuyTrend  := emaIsUp
        allowSellTrend := emaIsDown
    else if trendMode == "Dual Supertrend (Chart + HTF)"
        allowBuyTrend  := isUptrend and htfIsUp
        allowSellTrend := isDowntrend and htfIsDown
    else if trendMode == "None (No Filter)"
        allowBuyTrend  := true
        allowSellTrend := true

if useEma200 and trendMode != "200 EMA Baseline"
    allowBuyTrend  := allowBuyTrend and emaIsUp
    allowSellTrend := allowSellTrend and emaIsDown

// 6.4 DeMarker Calculation
deMax = high > high[1] ? high - high[1] : 0.0
deMin = low < low[1] ? low[1] - low : 0.0
avgDeMax = ta.sma(deMax, demPeriod)
avgDeMin = ta.sma(deMin, demPeriod)
demValue = (avgDeMax + avgDeMin) != 0.0 ? avgDeMax / (avgDeMax + avgDeMin) : 0.5

// 6.5 Stochastic RSI Calculation
rsiVal = ta.rsi(close, rsiLength)
stochRsi = ta.stoch(rsiVal, rsiVal, rsiVal, stochLength)
k = ta.sma(stochRsi, smoothK)
d = ta.sma(k, smoothD)

// =============================================================================
// 7. ANTI-SIDEWAY & STRUCTURAL FILTER CALCULATIONS
// =============================================================================
// 7.1 Donchian Swing High-Low Breakout
donchianHigh = ta.highest(high[1], donchianPeriod)
donchianLow  = ta.lowest(low[1], donchianPeriod)

passDonchian_Buy  = not useDonchian or (breakoutByClose ? (close >= donchianHigh) : (high >= donchianHigh))
passDonchian_Sell = not useDonchian or (breakoutByClose ? (close <= donchianLow)  : (low <= donchianLow))

// 7.2 Volume Expansion / RVOL
hasVolume    = not na(volume) and volume > 0
volMa        = ta.sma(volume, volumeMaLen)
volThreshold = volMa * volumeMult
passVolume   = not useVolume or not hasVolume or (volume >= volThreshold)

// 7.3 Kaufman's Efficiency Ratio (KER)
changeNet = math.abs(close - close[erPeriod])
sumDiffs  = math.sum(math.abs(close - close[1]), erPeriod)
effRatio  = sumDiffs != 0 ? (changeNet / sumDiffs) : 0.0
passER    = not useER or (effRatio >= minER)

// 7.4 Choppiness Index (CHOP)
hhChop    = ta.highest(high, chopLen)
llChop    = ta.lowest(low, chopLen)
rangeChop = hhChop - llChop
sumAtr1   = math.sum(ta.atr(1), chopLen)
chopVal   = (rangeChop > 0 and sumAtr1 > 0) ? 100 * (math.log10(sumAtr1 / rangeChop) / math.log10(chopLen)) : 50.0
passChop  = not useChop or (chopVal <= maxChop)

// 7.5 Bollinger Bands Width (BBW)
[bbBasis, bbUpper, bbLower] = ta.bb(close, bbLength, bbMult)
bbWidth   = bbBasis != 0 ? ((bbUpper - bbLower) / bbBasis) * 100 : 0.0
bbWidthAvg= ta.sma(bbWidth, bbSmaLen)
passBBW   = not useBBW or (bbWidth >= bbWidthAvg)

// 7.6 EMA Spread %
emaFast   = ta.ema(close, emaFastLen)
emaSlow   = ta.ema(close, emaSlowLen)
emaSpread = close != 0 ? (math.abs(emaFast - emaSlow) / close) * 100 : 0.0
passEMA   = not useEMASpread or (emaSpread >= minSpreadPct)

// Combine All Filter Validations
allFiltersPass_Buy  = passDonchian_Buy and passVolume and passER and passChop and passBBW and passEMA
allFiltersPass_Sell = passDonchian_Sell and passVolume and passER and passChop and passBBW and passEMA

// =============================================================================
// 8. ENTRY SIGNAL LOGIC (EVALUATED AT GLOBAL LEVEL)
// =============================================================================
// Cross Calculations on Every Bar
stochBuyCross  = ta.crossover(k, d)
stochSellCross = ta.crossunder(k, d)
demBuyCross    = ta.crossover(demValue, demOversold)
demSellCross   = ta.crossunder(demValue, demOverbought)

stochBuyCond   = stochBuyCross and (k <= stochOversold or k[1] <= stochOversold or k <= 30.0)
stochSellCond  = stochSellCross and (k >= stochOverbought or k[1] >= stochOverbought or k >= 70.0)

demBuyCond     = not useDeMarker or demValue <= demOversold or demValue[1] <= demOversold or demBuyCross
demSellCond    = not useDeMarker or demValue >= demOverbought or demValue[1] >= demOverbought or demSellCross

bool rawBuySignal  = false
bool rawSellSignal = false

if signalMode == "Combined (DeMarker + Stoch RSI)"
    rawBuySignal  := (not useStochRsi or stochBuyCond) and demBuyCond
    rawSellSignal := (not useStochRsi or stochSellCond) and demSellCond
else if signalMode == "DeMarker Only"
    rawBuySignal  := demBuyCross or (demValue <= demOversold and demValue > demValue[1])
    rawSellSignal := demSellCross or (demValue >= demOverbought and demValue < demValue[1])
else if signalMode == "Stoch RSI Only"
    rawBuySignal  := stochBuyCond
    rawSellSignal := stochSellCond
else if signalMode == "Momentum Continuation"
    rawBuySignal  := stochBuyCross and k < 60.0 and demValue > 0.4
    rawSellSignal := stochSellCross and k > 40.0 and demValue < 0.6

// Cooldown & Filtered Signal Execution
var int lastSignalBar = -100
barsSinceLast = bar_index - lastSignalBar

validBuy  = rawBuySignal and allowBuyTrend and allFiltersPass_Buy and (minBarsBetweenSignals <= 0 or barsSinceLast >= minBarsBetweenSignals)
validSell = rawSellSignal and allowSellTrend and allFiltersPass_Sell and (minBarsBetweenSignals <= 0 or barsSinceLast >= minBarsBetweenSignals)

if validBuy or validSell
    lastSignalBar := bar_index

// =============================================================================
// 9. PLOTTING & VISUALIZATION (NATIVE CHART SYNCHRONIZATION)
// =============================================================================
// 9.1 Supertrend Line
plot(plotSupertrendLine and isUptrend ? stValue : na, "Supertrend Uptrend", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
plot(plotSupertrendLine and isDowntrend ? stValue : na, "Supertrend Downtrend", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)

// 9.2 200 EMA Baseline
plot(plotEmaBaseline and useEma200 ? ema200Val : na, "200 EMA Baseline", color=color.new(color.yellow, 30), linewidth=2)

// 9.3 Donchian Breakout Reference Levels
plot(plotDonchianLevels and useDonchian ? donchianHigh : na, "Donchian High (Resistance)", color=color.new(color.teal, 60), style=plot.style_stepline)
plot(plotDonchianLevels and useDonchian ? donchianLow : na, "Donchian Low (Support)", color=color.new(color.maroon, 60), style=plot.style_stepline)

// 9.4 Buy / Sell Signals (Bound to Bar Index)
plotshape(validBuy, title="BUY Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="BUY", textcolor=color.white)
plotshape(validSell, title="SELL Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL", textcolor=color.white)

// 9.5 Alert Conditions
alertcondition(validBuy, title="Buy Signal Alert", message="[BUY] Supertrend + DeM + StochRSI trigger on {{ticker}} at {{close}}")
alertcondition(validSell, title="Sell Signal Alert", message="[SELL] Supertrend + DeM + StochRSI trigger on {{ticker}} at {{close}}")

// =============================================================================
// 10. REAL-TIME FILTER DASHBOARD
// =============================================================================
table_pos = switch dashboardPosition
    "Bottom Right" => position.bottom_right
    "Top Left"     => position.top_left
    "Bottom Left"  => position.bottom_left
    => position.top_right

var table infoTable = table.new(table_pos, 3, 10, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

if barstate.islast and showDashboard
    table.cell(infoTable, 0, 0, "Zerith Filter", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, "Status", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 0, "Current Value", bgcolor=color.navy, text_color=color.white, text_size=size.small)

    // Row 1: Trend Mode
    string trendLabel = not useTrendFilter ? "OFF" : (allowBuyTrend ? "BULL" : (allowSellTrend ? "BEAR" : "NEUTRAL"))
    color trendBgColor = not useTrendFilter ? color.gray : (allowBuyTrend ? color.green : (allowSellTrend ? color.red : color.orange))
    table.cell(infoTable, 0, 1, "Trend Filter", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, trendLabel, bgcolor=trendBgColor, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 1, useTrendFilter ? trendMode : "Disabled", text_color=color.white, text_size=size.small)

    // Row 2: Donchian Breakout
    bool donchianPassCurr = (isUptrend and passDonchian_Buy) or (isDowntrend and passDonchian_Sell)
    table.cell(infoTable, 0, 2, "Donchian Break", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, useDonchian ? (donchianPassCurr ? "PASS" : "BLOCKED") : "OFF", bgcolor=useDonchian ? (donchianPassCurr ? color.green : color.red) : color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 2, isUptrend ? ("H: " + str.tostring(donchianHigh, "#.##")) : ("L: " + str.tostring(donchianLow, "#.##")), text_color=color.white, text_size=size.small)

    // Row 3: Volume RVOL
    table.cell(infoTable, 0, 3, "Volume (RVOL)", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 3, useVolume ? (passVolume ? "PASS" : "LOW VOL") : "OFF", bgcolor=useVolume ? (passVolume ? color.green : color.red) : color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 3, hasVolume ? (str.tostring(volume, "#") + " / " + str.tostring(volThreshold, "#")) : "No Vol Data", text_color=color.white, text_size=size.small)

    // Row 4: Kaufman ER
    table.cell(infoTable, 0, 4, "Kaufman ER", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 4, useER ? (passER ? "PASS" : "BLOCKED") : "OFF", bgcolor=useER ? (passER ? color.green : color.red) : color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 4, str.tostring(effRatio, "#.##") + " / " + str.tostring(minER, "#.##"), text_color=color.white, text_size=size.small)

    // Row 5: Choppiness Index
    table.cell(infoTable, 0, 5, "Chop Index", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 5, useChop ? (passChop ? "PASS" : "BLOCKED") : "OFF", bgcolor=useChop ? (passChop ? color.green : color.red) : color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 5, str.tostring(chopVal, "#.#") + " / " + str.tostring(maxChop, "#.#"), text_color=color.white, text_size=size.small)

    // Row 6: BB Width
    table.cell(infoTable, 0, 6, "BB Width", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 6, useBBW ? (passBBW ? "PASS" : "BLOCKED") : "OFF", bgcolor=useBBW ? (passBBW ? color.green : color.red) : color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 6, str.tostring(bbWidth, "#.##") + " (Avg " + str.tostring(bbWidthAvg, "#.##") + ")", text_color=color.white, text_size=size.small)

    // Row 7: EMA Spread %
    table.cell(infoTable, 0, 7, "EMA Spread %", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 7, useEMASpread ? (passEMA ? "PASS" : "BLOCKED") : "OFF", bgcolor=useEMASpread ? (passEMA ? color.green : color.red) : color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 7, str.tostring(emaSpread, "#.##") + "% / " + str.tostring(minSpreadPct, "#.##") + "%", text_color=color.white, text_size=size.small)

    // Row 8: HTF Supertrend
    table.cell(infoTable, 0, 8, "HTF Supertrend", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 8, (trendMode == "Higher Timeframe (HTF) Supertrend" or trendMode == "Dual Supertrend (Chart + HTF)") ? (htfIsUp ? "BULL" : "BEAR") : "OFF", bgcolor=(trendMode == "Higher Timeframe (HTF) Supertrend" or trendMode == "Dual Supertrend (Chart + HTF)") ? (htfIsUp ? color.green : color.red) : color.gray, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 8, "TF: " + htfTimeframe, text_color=color.white, text_size=size.small)

    // Row 9: Signal Cooldown
    table.cell(infoTable, 0, 9, "Signal Cooldown", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 9, (minBarsBetweenSignals <= 0 or barsSinceLast >= minBarsBetweenSignals) ? "READY" : "WAIT", bgcolor=(minBarsBetweenSignals <= 0 or barsSinceLast >= minBarsBetweenSignals) ? color.teal : color.orange, text_color=color.white, text_size=size.small)
    table.cell(infoTable, 2, 9, str.tostring(barsSinceLast) + " / " + str.tostring(minBarsBetweenSignals) + " bars", text_color=color.white, text_size=size.small)
