//@version=5
indicator("Quantum Queen X + Supertrend Signal", overlay=true)

// =============================================================================
// 1. SUPERTREND SETTINGS (REPLACING TIME FILTER AS MAIN TREND)
// =============================================================================
atrPeriod       = input.int(10, "Supertrend ATR Period", group="1. Supertrend (Main Trend Filter)")
atrMultiplier   = input.float(3.0, "Supertrend Multiplier", step=0.1, group="1. Supertrend (Main Trend Filter)")
useSupertrend   = input.bool(true, "Enable Supertrend Filter", group="1. Supertrend (Main Trend Filter)")

// =============================================================================
// 2. DIRECTION & PRESET MODES
// =============================================================================
presetMode      = input.string("IC/VT Markets High Risk", "Preset Selection", options=["IC/VT Markets High Risk", "IC/VT Markets Medium Risk", "IC/VT Markets Low Risk", "RoboForex ECN", "Fusion Markets Zero", "All 12 Strategies", "Custom"], group="2. Presets & Direction")
dirMode         = input.string("Both Directions (Per Strategy Bias)", "Direction Mode", options=["Both Directions (Per Strategy Bias)", "Dynamic (Trend Follows Supertrend)", "Buy Only", "Sell Only"], group="2. Presets & Direction")
minBarsCooldown = input.int(5, "Min Bars Cooldown Between Signals", minval=1, group="2. Presets & Direction")

// =============================================================================
// 3. STRATEGY SELECTION TOGGLES (FOR CUSTOM PRESET)
// =============================================================================
s01_on = input.bool(true,  "S01: M6(18) + M15(16) [BUY]",  group="3. Strategy Selection (Custom)")
s02_on = input.bool(true,  "S02: M15(14) + M20(20) [BUY]", group="3. Strategy Selection (Custom)")
s03_on = input.bool(true,  "S03: M15(26) + M15(24) [BUY]", group="3. Strategy Selection (Custom)")
s04_on = input.bool(true,  "S04: M15(20) + M20(22) [BUY]", group="3. Strategy Selection (Custom)")
s05_on = input.bool(true,  "S05: M1(18) + M15(18) [SELL]", group="3. Strategy Selection (Custom)")
s06_on = input.bool(true,  "S06: M10(30) + M30(28) [SELL]", group="3. Strategy Selection (Custom)")
s07_on = input.bool(false, "S07: M1(20) + M20(16) [BUY]",  group="3. Strategy Selection (Custom)")
s08_on = input.bool(true,  "S08: M1(12) + H1(20) [BUY]",   group="3. Strategy Selection (Custom)")
s09_on = input.bool(true,  "S09: M12(18) + M15(12) [BUY]", group="3. Strategy Selection (Custom)")
s10_on = input.bool(true,  "S10: M10(20) + M15(10) [BUY]", group="3. Strategy Selection (Custom)")
s11_on = input.bool(false, "S11: M10(30) + M30(28) [SELL]", group="3. Strategy Selection (Custom)")
s12_on = input.bool(true,  "S12: M12(10) + M15(20) [SELL]", group="3. Strategy Selection (Custom)")

// =============================================================================
// 4. RISK & TARGET VISUALIZATION
// =============================================================================
showTPSL        = input.bool(true, "Show TP/SL Level on Signal", group="4. TP/SL Targets")
tpPoints        = input.float(50.0, "Take Profit Distance (Pips / Gold $0.1)", step=5.0, group="4. TP/SL Targets")
slPoints        = input.float(30.0, "Stop Loss Distance (Pips / Gold $0.1)", step=5.0, group="4. TP/SL Targets")
showDashboard   = input.bool(true, "Show Quantum Status Dashboard", group="5. Dashboard")

// =============================================================================
// 5. SUPERTREND CALCULATION
// =============================================================================
[stValue, stDirection] = ta.supertrend(atrMultiplier, atrPeriod)
isUptrend   = stDirection < 0
isDowntrend = stDirection > 0

// =============================================================================
// 6. MULTI-TIMEFRAME DEMARKER ENGINE
// =============================================================================
f_demarker(len) =>
    deMax = high > high[1] ? high - high[1] : 0.0
    deMin = low < low[1] ? low[1] - low : 0.0
    avgDeMax = ta.sma(deMax, len)
    avgDeMin = ta.sma(deMin, len)
    denom = avgDeMax + avgDeMin
    denom != 0 ? avgDeMax / denom : 0.5

// Fetch Multi-Timeframe DeMarker values
dem_m1_12  = request.security(syminfo.tickerid, "1",  f_demarker(12), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_m1_18  = request.security(syminfo.tickerid, "1",  f_demarker(18), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_m1_20  = request.security(syminfo.tickerid, "1",  f_demarker(20), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_m6_18  = request.security(syminfo.tickerid, "6",  f_demarker(18), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_m10_20 = request.security(syminfo.tickerid, "10", f_demarker(20), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_m10_30 = request.security(syminfo.tickerid, "10", f_demarker(30), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_m12_10 = request.security(syminfo.tickerid, "12", f_demarker(10), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_m12_18 = request.security(syminfo.tickerid, "12", f_demarker(18), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_m15_10 = request.security(syminfo.tickerid, "15", f_demarker(10), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_m15_12 = request.security(syminfo.tickerid, "15", f_demarker(12), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_m15_14 = request.security(syminfo.tickerid, "15", f_demarker(14), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_m15_16 = request.security(syminfo.tickerid, "15", f_demarker(16), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_m15_18 = request.security(syminfo.tickerid, "15", f_demarker(18), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_m15_20 = request.security(syminfo.tickerid, "15", f_demarker(20), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_m15_24 = request.security(syminfo.tickerid, "15", f_demarker(24), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_m15_26 = request.security(syminfo.tickerid, "15", f_demarker(26), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_m20_16 = request.security(syminfo.tickerid, "20", f_demarker(16), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_m20_20 = request.security(syminfo.tickerid, "20", f_demarker(20), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_m20_22 = request.security(syminfo.tickerid, "20", f_demarker(22), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_m30_28 = request.security(syminfo.tickerid, "30", f_demarker(28), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dem_h1_20  = request.security(syminfo.tickerid, "60", f_demarker(20), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// Helper: Direction evaluator
f_demDir(val, upper, lower) =>
    val > upper ? 1 : (val < lower ? -1 : 0)

// =============================================================================
// 7. PRESET ACTIVE STATUS LOGIC
// =============================================================================
f_isStratActive(idx) =>
    bool active = false
    if presetMode == "Custom"
        active := (idx == 0 and s01_on) or (idx == 1 and s02_on) or (idx == 2 and s03_on) or (idx == 3 and s04_on) or (idx == 4 and s05_on) or (idx == 5 and s06_on) or (idx == 6 and s07_on) or (idx == 7 and s08_on) or (idx == 8 and s09_on) or (idx == 9 and s10_on) or (idx == 10 and s11_on) or (idx == 11 and s12_on)
    else if presetMode == "IC/VT Markets High Risk"
        active := idx == 0 or idx == 1 or idx == 2 or idx == 4 or idx == 5 or idx == 7 or idx == 8 or idx == 9 or idx == 11
    else if presetMode == "IC/VT Markets Medium Risk"
        active := idx == 0 or idx == 1 or idx == 2 or idx == 4 or idx == 5 or idx == 7 or idx == 8 or idx == 11
    else if presetMode == "IC/VT Markets Low Risk"
        active := idx == 0 or idx == 1 or idx == 2 or idx == 4 or idx == 7 or idx == 8 or idx == 11
    else if presetMode == "RoboForex ECN"
        active := idx == 0 or idx == 1 or idx == 2 or idx == 4 or idx == 5 or idx == 7 or idx == 8 or idx == 9 or idx == 11
    else if presetMode == "Fusion Markets Zero"
        active := idx == 0 or idx == 2 or idx == 3 or idx == 4 or idx == 7 or idx == 8 or idx == 11
    else if presetMode == "All 12 Strategies"
        active := true
    active

// =============================================================================
// 8. 12 STRATEGIES EVALUATION
// =============================================================================
// Calculate dual DeMarker signals for each strategy
s01_sig = f_demDir(dem_m6_18,  0.7, 0.3) == f_demDir(dem_m15_16, 0.7, 0.3) ? f_demDir(dem_m6_18,  0.7, 0.3) : 0
s02_sig = f_demDir(dem_m15_14, 0.7, 0.3) == f_demDir(dem_m20_20, 0.7, 0.3) ? f_demDir(dem_m15_14, 0.7, 0.3) : 0
s03_sig = f_demDir(dem_m15_26, 0.7, 0.3) == f_demDir(dem_m15_24, 0.7, 0.3) ? f_demDir(dem_m15_26, 0.7, 0.3) : 0
s04_sig = f_demDir(dem_m15_20, 0.7, 0.3) == f_demDir(dem_m20_22, 0.7, 0.3) ? f_demDir(dem_m15_20, 0.7, 0.3) : 0
s05_sig = f_demDir(dem_m1_18,  0.7, 0.3) == f_demDir(dem_m15_18, 0.7, 0.3) ? f_demDir(dem_m1_18,  0.7, 0.3) : 0
s06_sig = f_demDir(dem_m10_30, 0.7, 0.3) == f_demDir(dem_m30_28, 0.7, 0.3) ? f_demDir(dem_m10_30, 0.7, 0.3) : 0
s07_sig = f_demDir(dem_m1_20,  0.9, 0.3) == f_demDir(dem_m20_16, 0.7, 0.3) ? f_demDir(dem_m1_20,  0.9, 0.3) : 0
s08_sig = f_demDir(dem_m1_12,  0.5, 0.3) == f_demDir(dem_h1_20,  0.9, 0.3) ? f_demDir(dem_m1_12,  0.5, 0.3) : 0
s09_sig = f_demDir(dem_m12_18, 0.9, 0.3) == f_demDir(dem_m15_12, 0.9, 0.3) ? f_demDir(dem_m12_18, 0.9, 0.3) : 0
s10_sig = f_demDir(dem_m10_20, 0.7, 0.3) == f_demDir(dem_m15_10, 0.9, 0.3) ? f_demDir(dem_m10_20, 0.7, 0.3) : 0
s11_sig = f_demDir(dem_m10_30, 0.7, 0.3) == f_demDir(dem_m30_28, 0.7, 0.3) ? f_demDir(dem_m10_30, 0.7, 0.3) : 0
s12_sig = f_demDir(dem_m12_10, 0.7, 0.1) == f_demDir(dem_m15_20, 0.7, 0.3) ? f_demDir(dem_m12_10, 0.7, 0.1) : 0

// Strategy Direction Bias (Original QQ: S1-S4, S7-S10 = Buy; S5, S6, S11, S12 = Sell)
f_allowedDir(idx) =>
    if dirMode == "Buy Only"
        1
    else if dirMode == "Sell Only"
        -1
    else if dirMode == "Dynamic (Trend Follows Supertrend)"
        isUptrend ? 1 : (isDowntrend ? -1 : 0)
    else // Both Directions (Per Strategy Bias)
        (idx == 4 or idx == 5 or idx == 10 or idx == 11) ? -1 : 1

// Check triggering for each strategy
bool buyTriggered  = false
bool sellTriggered = false
string trigTag     = ""

if f_isStratActive(0) and s01_sig != 0 and s01_sig == f_allowedDir(0)
    if s01_sig == 1 and (not useSupertrend or isUptrend)
        buyTriggered := true
        trigTag := trigTag + "[S1] "
    if s01_sig == -1 and (not useSupertrend or isDowntrend)
        sellTriggered := true
        trigTag := trigTag + "[S1] "

if f_isStratActive(1) and s02_sig != 0 and s02_sig == f_allowedDir(1)
    if s02_sig == 1 and (not useSupertrend or isUptrend)
        buyTriggered := true
        trigTag := trigTag + "[S2] "
    if s02_sig == -1 and (not useSupertrend or isDowntrend)
        sellTriggered := true
        trigTag := trigTag + "[S2] "

if f_isStratActive(2) and s03_sig != 0 and s03_sig == f_allowedDir(2)
    if s03_sig == 1 and (not useSupertrend or isUptrend)
        buyTriggered := true
        trigTag := trigTag + "[S3] "
    if s03_sig == -1 and (not useSupertrend or isDowntrend)
        sellTriggered := true
        trigTag := trigTag + "[S3] "

if f_isStratActive(3) and s04_sig != 0 and s04_sig == f_allowedDir(3)
    if s04_sig == 1 and (not useSupertrend or isUptrend)
        buyTriggered := true
        trigTag := trigTag + "[S4] "
    if s04_sig == -1 and (not useSupertrend or isDowntrend)
        sellTriggered := true
        trigTag := trigTag + "[S4] "

if f_isStratActive(4) and s05_sig != 0 and s05_sig == f_allowedDir(4)
    if s05_sig == 1 and (not useSupertrend or isUptrend)
        buyTriggered := true
        trigTag := trigTag + "[S5] "
    if s05_sig == -1 and (not useSupertrend or isDowntrend)
        sellTriggered := true
        trigTag := trigTag + "[S5] "

if f_isStratActive(5) and s06_sig != 0 and s06_sig == f_allowedDir(5)
    if s06_sig == 1 and (not useSupertrend or isUptrend)
        buyTriggered := true
        trigTag := trigTag + "[S6] "
    if s06_sig == -1 and (not useSupertrend or isDowntrend)
        sellTriggered := true
        trigTag := trigTag + "[S6] "

if f_isStratActive(6) and s07_sig != 0 and s07_sig == f_allowedDir(6)
    if s07_sig == 1 and (not useSupertrend or isUptrend)
        buyTriggered := true
        trigTag := trigTag + "[S7] "
    if s07_sig == -1 and (not useSupertrend or isDowntrend)
        sellTriggered := true
        trigTag := trigTag + "[S7] "

if f_isStratActive(7) and s08_sig != 0 and s08_sig == f_allowedDir(7)
    if s08_sig == 1 and (not useSupertrend or isUptrend)
        buyTriggered := true
        trigTag := trigTag + "[S8] "
    if s08_sig == -1 and (not useSupertrend or isDowntrend)
        sellTriggered := true
        trigTag := trigTag + "[S8] "

if f_isStratActive(8) and s09_sig != 0 and s09_sig == f_allowedDir(8)
    if s09_sig == 1 and (not useSupertrend or isUptrend)
        buyTriggered := true
        trigTag := trigTag + "[S9] "
    if s09_sig == -1 and (not useSupertrend or isDowntrend)
        sellTriggered := true
        trigTag := trigTag + "[S9] "

if f_isStratActive(9) and s10_sig != 0 and s10_sig == f_allowedDir(9)
    if s10_sig == 1 and (not useSupertrend or isUptrend)
        buyTriggered := true
        trigTag := trigTag + "[S10] "
    if s10_sig == -1 and (not useSupertrend or isDowntrend)
        sellTriggered := true
        trigTag := trigTag + "[S10] "

if f_isStratActive(10) and s11_sig != 0 and s11_sig == f_allowedDir(10)
    if s11_sig == 1 and (not useSupertrend or isUptrend)
        buyTriggered := true
        trigTag := trigTag + "[S11] "
    if s11_sig == -1 and (not useSupertrend or isDowntrend)
        sellTriggered := true
        trigTag := trigTag + "[S11] "

if f_isStratActive(11) and s12_sig != 0 and s12_sig == f_allowedDir(11)
    if s12_sig == 1 and (not useSupertrend or isUptrend)
        buyTriggered := true
        trigTag := trigTag + "[S12] "
    if s12_sig == -1 and (not useSupertrend or isDowntrend)
        sellTriggered := true
        trigTag := trigTag + "[S12] "

// =============================================================================
// 9. COOLDOWN & FINAL SIGNAL GENERATION
// =============================================================================
var int lastSignalBar = -100
barsSinceLast = bar_index - lastSignalBar

validBuy  = buyTriggered  and (barsSinceLast >= minBarsCooldown)
validSell = sellTriggered and (barsSinceLast >= minBarsCooldown)

if validBuy or validSell
    lastSignalBar := bar_index

// Calculate TP/SL prices
var float entryPrice = na
var float tpPrice = na
var float slPrice = na

if validBuy
    entryPrice := close
    tpPrice    := close + tpPoints * syminfo.mintick * 10
    slPrice    := close - slPoints * syminfo.mintick * 10
else if validSell
    entryPrice := close
    tpPrice    := close - tpPoints * syminfo.mintick * 10
    slPrice    := close + slPoints * syminfo.mintick * 10

// =============================================================================
// 10. PLOTTING & ALERTS
// =============================================================================
// Supertrend Line
plot(isUptrend ? stValue : na, "Supertrend Bullish", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
plot(isDowntrend ? stValue : na, "Supertrend Bearish", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)

// Buy & Sell Markers
plotshape(validBuy, title="QQ BUY Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="QQ BUY", textcolor=color.white)
plotshape(validSell, title="QQ SELL Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="QQ SELL", textcolor=color.white)

// Plot Dynamic TP/SL
plot(showTPSL and not na(tpPrice) ? tpPrice : na, "Take Profit Target", color=color.teal, linewidth=1, style=plot.style_circles)
plot(showTPSL and not na(slPrice) ? slPrice : na, "Stop Loss Target", color=color.maroon, linewidth=1, style=plot.style_circles)

// Alerts
alertcondition(validBuy, title="Quantum Queen BUY Alert", message="[QQ BUY] Signal on {{ticker}} at {{close}}")
alertcondition(validSell, title="Quantum Queen SELL Alert", message="[QQ SELL] Signal on {{ticker}} at {{close}}")

// =============================================================================
// 11. QUANTUM QUEEN LIVE DASHBOARD
// =============================================================================
var table dash = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

if barstate.islast and showDashboard
    table.cell(dash, 0, 0, "Quantum Queen X", bgcolor=color.purple, text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, "Status", bgcolor=color.purple, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 1, "Main Supertrend", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, isUptrend ? "BULLISH" : "BEARISH", bgcolor=isUptrend ? color.green : color.red, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 2, "Active Preset", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, presetMode, bgcolor=color.navy, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 3, "Direction Mode", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, dirMode == "Both Directions (Per Strategy Bias)" ? "Per Strategy" : (dirMode == "Dynamic (Trend Follows Supertrend)" ? "Dynamic ST" : dirMode), bgcolor=color.darkgray, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 4, "Active Modules", text_color=color.white, text_size=size.small)
    int activeCount = 0
    for i = 0 to 11
        if f_isStratActive(i)
            activeCount += 1
    table.cell(dash, 1, 4, str.tostring(activeCount) + " / 12 Active", bgcolor=color.teal, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 5, "Cooldown State", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, barsSinceLast >= minBarsCooldown ? "READY" : ("WAIT " + str.tostring(minBarsCooldown - barsSinceLast) + "b"), bgcolor=barsSinceLast >= minBarsCooldown ? color.green : color.orange, text_color=color.white, text_size=size.small)

    table.cell(dash, 0, 6, "Latest Signal", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, trigTag != "" ? trigTag : "No Trigger", bgcolor=trigTag != "" ? color.blue : color.gray, text_color=color.white, text_size=size.small)
