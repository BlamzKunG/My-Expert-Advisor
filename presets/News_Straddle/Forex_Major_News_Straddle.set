;============================================================
; Zerith News Straddle Reverse-Trailing EA - Preset: Forex Majors (EURUSD, GBPUSD)
; Optimized for High-Impact FX News: Non-Farm Payrolls, CPI, Rate Decisions
; Strategy: Straddle Breakout with Opposite Stop Trailing SL & Reversal
;============================================================
InpTriggerMode=0
InpNewsTime=15:30:00
InpSecondsBeforeNews=20
InpStraddleDistancePoints=150.0
InpPendingExpiryMinutes=30

;--- Opposite Order Trailing
InpTrailingStartPoints=80.0
InpTrailingDistancePoints=100.0
InpTrailingStepPoints=10.0

;--- Reversal & Recovery
InpMaxReversals=4
InpReverseMultiplier=1.0
InpReverseDistancePoints=0.0
InpOnMaxReversals=0

;--- Money Management
InpLotMode=0
InpFixedLot=0.01
InpRiskPercent=1.0
InpTakeProfitPoints=0.0
InpTargetProfitMoney=0.0

;--- Capital Protection & Filters
InpMaxSpreadPoints=30.0
InpEnableDDProtection=true
InpMaxTotalDDPercent=10.0
InpMaxDailyLossPercent=5.0
InpMagicNumber=889902
InpSlippage=15
InpTradeComment=FX_NewsStraddle

;--- HUD
InpShowPanel=true
InpPanelX=20
InpPanelY=30
